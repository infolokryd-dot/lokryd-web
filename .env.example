# ==============================================================================
# LOKRYD Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (Mumbai Project)
# ------------------------------------------------------------------------------
# Browser-safe Supabase URL & Publishable Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side Supabase URL & Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used exclusively on the server to bypass Row Level Security (RLS) safely from server routes
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ------------------------------------------------------------------------------
# 2. Transactional Email Configuration (Resend)
# ------------------------------------------------------------------------------
# Resend API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# Verified Sender Address (Must belong to a domain verified in Resend dashboard)
# Example: LOKRYD <notifications@lokryd.com> or LOKRYD <onboarding@resend.dev> for testing
RESEND_FROM_EMAIL=

# Destination email where incoming customer enquiries are delivered
CONTACT_NOTIFICATION_EMAIL=info.lokryd@gmail.com

# ------------------------------------------------------------------------------
# 3. Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
